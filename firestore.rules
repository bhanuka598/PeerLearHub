rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;

      match /profile/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      match /enrollments/{courseId} {
        allow read, create, update: if request.auth != null
          && request.auth.uid == userId;
      }

      match /assignments/{courseId} {
        allow read, create, update: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /lessons/{lessonId} {
      allow read, write: if request.auth != null;
    }

    match /reviews/{reviewId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.learnerId;
    }

    match /teacherProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    // Helper function to check if user is moderator
    function isModerator() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator';
    }

    match /reports/{reportId} {
      allow read: if request.auth != null && (isModerator() || resource.data.reportedBy == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if isModerator();
    }

    match /verificationRequests/{requestId} {
      allow read: if request.auth != null && (isModerator() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if isModerator();
    }

    match /moderationLogs/{logId} {
      allow read, write: if isModerator();
    }
  }
}