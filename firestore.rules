rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;

      match /enrollments/{courseId} {
        allow read, create, update: if request.auth != null
          && request.auth.uid == userId;
      }

      match /assignments/{courseId} {
        allow read, create, update: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}